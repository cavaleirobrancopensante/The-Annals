## The localised copy of a data file or folder (under res://data/i18n/<language>/), or the English original
## when the chosen language has no copy yet.
static func data(path: String) -> String:
	var lang := current_language()
	if lang == "en" or not path.begins_with("res://data/"):
		return path
	var local := "res://data/i18n/%s/%s" % [lang, path.trim_prefix("res://data/")]
	if FileAccess.file_exists(local) or DirAccess.dir_exists_absolute(local):
		return local
	return path


## The language chosen in Settings. Looked up by name, so this file compiles before the autoloads exist.
static func current_language() -> String:
	return str(Engine.get_main_loop().root.get_node("Settings").language)


## Autoloads that read static data files. Each has load_data(); called again when the language changes.
const DATA_USERS := ["Calendar", "Skills", "Paths", "Road", "Rule", "Skirmish", "Chronicle", "EventEngine", "WorldState"]


static func reload_data() -> void:
	var tree_root: Node = Engine.get_main_loop().root
	for name in DATA_USERS:
		var node := tree_root.get_node_or_null(name)
		if node and node.has_method("load_data"):
			node.load_data()


## Registers one Translation per language. Called once from Settings at start.
static func register() -> void:
	for loc in LANGUAGES:
		var t := Translation.new()
		t.locale = loc
		var i := LANGUAGES.find(loc)
		for key in TABLE:
			t.add_message(key, str(TABLE[key][i]))
		TranslationServer.add_translation(t)
